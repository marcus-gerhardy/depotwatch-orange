{
  "name": "depotwatch-orange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:export": "DEPOTWATCH_TARGET=export next dev",
    "dev:debug": "NODE_OPTIONS=\"--max-old-space-size=8192 --heapsnapshot-near-heap-limit=1 --heap-prof\" next dev",
    "build": "npm run config:validate && next build && npm run sw:build",
    "build:server": "npm run config:validate && DEPOTWATCH_TARGET=server next build",
    "start": "next start",
    "config:validate": "npm run presets:validate && npm run feeds:validate",
    "presets:validate": "node scripts/validate-import-presets.mjs",
    "feeds:validate": "node scripts/validate-news-feeds.mjs",
    "lint": "npm run config:validate && eslint",
    "help:build": "python3 scripts/build-help.py",
    "demo:prices": "python3 scripts/fetch-demo-prices.py",
    "demo:build": "python3 scripts/build-demo-portfolio.py",
    "icons:build": "node scripts/build-icons.mjs",
    "help:screenshots": "npm run build && node scripts/help-screenshots.mjs",
    "test": "vitest run",
    "sw:build": "node scripts/build-sw.mjs",
    "portfolio:check": "jiti scripts/validate-portfolio.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^2.2.4",
    "recharts": "^3.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
